# Production Environment Variables
# Copy this file to .env.production and fill in actual values

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=suqly_prod
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=CHANGE_ME_VERY_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS

# Twilio (SMS)
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE=+1234567890

# SendGrid (Email)
SENDGRID_API_KEY=CHANGE_ME
SENDGRID_FROM_EMAIL=noreply@suqly.com

# Stripe
STRIPE_SECRET_KEY=CHANGE_ME_sk_live_xxx
STRIPE_PUBLIC_KEY=CHANGE_ME_pk_live_xxx
STRIPE_WEBHOOK_SECRET=CHANGE_ME_whsec_xxx

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=CHANGE_ME
FIREBASE_PRIVATE_KEY=CHANGE_ME
FIREBASE_CLIENT_EMAIL=CHANGE_ME

# OpenSearch
OPENSEARCH_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Sentry (Error Tracking)
SENTRY_DSN=CHANGE_ME

# Server
NODE_ENV=production
PORT=3001

# Frontend
NEXT_PUBLIC_API_URL=https://api.suqly.com
NEXT_PUBLIC_APP_NAME=Suqly
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_SENTRY=true

# Domain
DOMAIN=suqly.com
API_DOMAIN=api.suqly.com
